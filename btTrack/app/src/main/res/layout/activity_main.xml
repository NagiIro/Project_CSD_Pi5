<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="觸發距離（公尺）"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvDistance"
            android:text="0.5 m"
            android:textSize="24sp"
            android:textColor="#1565C0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/seekDistance"
            android:max="99"
            android:progress="4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="0.1 m（極近） — 10 m（遠）。預設 0.5 m，能設多近就多近。"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="HTTP 請求設定"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etUrl"
            android:hint="URL，例如 https://example.com/api/beacon"
            android:inputType="textUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etBody"
            android:hint="POST Body（可留空 = GET）"
            android:minLines="2"
            android:gravity="top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/cbOpenBrowser"
            android:text="觸發時同時開啟網頁（跳轉瀏覽器）"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="每次觸發的冷卻時間（秒）"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etCooldown"
            android:text="30"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnStart"
                android:text="啟動背景掃描"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnStop"
                android:text="停止"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTest"
            android:text="測試發送 HTTP 請求"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvStatus"
            android:text="尚未啟動"
            android:paddingTop="12dp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvBeacons"
            android:text="尚未偵測到 beacon"
            android:paddingTop="8dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
